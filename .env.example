# Copy to .env and adjust.
MYDNS_DB_PASSWORD=mydns
# Host port for DNS (udp and tcp). 53 is often taken by systemd-resolved.
MYDNS_PORT=5353
# yes = allow AXFR (each zone's soa.xfer column still limits who may transfer it)
MYDNS_ALLOW_AXFR=no
# Forward queries for zones not in the database, e.g. 9.9.9.9
MYDNS_RECURSIVE=
